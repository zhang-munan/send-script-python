# 与后端使用同一套 MySQL。不要提交真实密码。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=app_user
DB_PASSWORD=change-me
DB_DATABASE=db_bangni
# MySQL 会话时区；必须与后端业务时区一致。
DB_TIMEZONE=+08:00

# 留空表示自动使用所有处于 device 状态的 USB 手机。
ADB_PATH=adb
ADB_DEVICE_SERIALS=

POLL_INTERVAL_SECONDS=2
DEVICE_REFRESH_SECONDS=5
ADB_COMMAND_TIMEOUT_SECONDS=20
UI_WAIT_SECONDS=1.2
STALE_CLAIM_SECONDS=300

# 双卡手机可设置 1 或 2；为空时使用短信应用默认卡。
SIM_SLOT=
WAKE_AND_DISMISS_KEYGUARD=true
LOG_LEVEL=INFO
