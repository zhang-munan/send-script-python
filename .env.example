# 与 backend/src/config/config.prod.ts 使用同一套 MySQL。不要提交真实密码。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=app_user
DB_PASSWORD=change-me
DB_DATABASE=db_bangni

# adb 可执行文件；留空设备列表表示自动使用所有处于 device 状态的 USB 手机。
ADB_PATH=adb
ADB_DEVICE_SERIALS=

# 调度与 UI 参数
POLL_INTERVAL_SECONDS=2
DEVICE_REFRESH_SECONDS=5
ADB_COMMAND_TIMEOUT_SECONDS=20
UI_WAIT_SECONDS=1.2
STALE_CLAIM_SECONDS=300

# 双卡手机可设置 1 或 2；为空时使用手机短信应用中的默认发送卡。
SIM_SLOT=

# true 会唤醒屏幕并尝试滑过无密码锁屏，但不能绕过 PIN/指纹/图案。
WAKE_AND_DISMISS_KEYGUARD=true

# INFO / DEBUG
LOG_LEVEL=INFO

